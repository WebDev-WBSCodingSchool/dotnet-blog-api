{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=blog.db"
  },
  "Jwt": {
    "Issuer": "BlogApi",
    "Audience": "BlogApi",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
